# Copiar a .env (cp .env.example .env) y cambiar TODOS los valores CAMBIAR-*. El .env NO se sube a git.
#
# Nombre del despliegue. Los contenedores se llaman <servicio>-<SID> (p. ej. wazuh-indexer-triplesoc) y los
# scripts de ops/ y de cada servicio los buscan así:  SID=triplesoc ./ops/upgrade-check.sh
SID=triplesoc

# Usuario admin del indexer. Debe coincidir con el hash de "admin" en config/wazuh_indexer/internal_users.yml.
INDEXER_PASSWORD=CAMBIAR-admin-indexer
# Usuario kibanaserver (lo usa el dashboard por dentro). Debe coincidir con su hash en internal_users.yml.
DASHBOARD_PASSWORD=CAMBIAR-kibanaserver
# Usuario wazuh-wui de la API de Wazuh. Mayúscula, minúscula, número y símbolo (.*+?-), 8-64 caracteres.
# Debe ser la misma que password en config/wazuh_dashboard/wazuh.yml.
API_PASSWORD=CAMBIAR-Api.Wazuh1

# Puerto local del dashboard (HTTP). Delante debe ir un proxy con HTTPS (obligatorio para el login con Logto).
DASHBOARD_PORT=5601
# Memoria del indexer: la mitad de mem_limit del servicio (por defecto 4g -> 2g).
INDEXER_HEAP=2g
