# Identidad visual TripleSOC (estilo triplecyber.com/products/triplesoc).
# Cambiar un valor aquí y reconstruir la imagen (./build.sh) propaga el cambio
# a logos, favicons, reportes y CSS.

TSOC_APP_TITLE="TripleSOC"

# Colores de marca TripleCyber
TSOC_DARK="#161616"          # carbón: fondo / texto de marca sobre claro
TSOC_GREEN="#1AA54A"         # verde TripleCyber ("Triple", estados seguros)
TSOC_RED="#BB2227"           # rojo TripleCyber ("SOC", crítico)
TSOC_RED_ON_DARK="#E5484D"   # rojo legible sobre fondo oscuro
TSOC_GRAY="#4A4A4A"          # gris TripleCyber (bordes del escudo, secundario)

# Acciones: botones con relleno (texto blanco, contraste AA >= 4.5:1)
TSOC_PRIMARY="#13843B"
TSOC_PRIMARY_HOVER="#0F6E31"
TSOC_PRIMARY_RGB="19, 132, 59"

# Acento sobre fondo oscuro: enlaces, pestaña/menú activo, foco (contraste 5.5:1 sobre carbón)
TSOC_ACCENT="#1AA54A"
TSOC_ACCENT_RGB="26, 165, 74"
TSOC_ACCENT_DARK="#1AA54A"   # sustituye al primario del tema oscuro de EUI (#1BA9F5)
TSOC_ACCENT_DARK_RGB="26, 165, 74"

# Reportes PDF (valores por defecto de cabecera/pie)
TSOC_REPORT_EMAIL="soc@triplecyber.com.do"
TSOC_COMPANY="TripleCyber"
