{
  "contract": "triplesoc.schema/v1",
  "adapter": "wazuh-4.x",
  "alerts_index": "triplesoc-alerts-*",
  "legacy_alerts_index": "wazuh-alerts-*",
  "monitoring_index": "wazuh-monitoring-*",
  "fields": {
    "timestamp": "timestamp",
    "alert_id": "id",
    "severity": "rule.level",
    "rule_id": "rule.id",
    "rule_description": "rule.description",
    "rule_groups": "rule.groups",
    "rule_mitre": "rule.mitre",
    "agent_id": "agent.id",
    "agent_name": "agent.name",
    "agent_ip": "agent.ip"
  },
  "severity_bands": {
    "critical": 12,
    "high": 7
  }
}
